{
  "name": "yueyue-launcher",
  "version": "0.1.2",
  "private": true,
  "description": "YueYue Launcher (YYL) - Mindustry instance launcher",
  "author": "YYL",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "check:dist": "node scripts/check-singlefile.mjs",
    "tauri": "tauri",
    "start": "npm run build && electron .",
    "dist:win": "node scripts/build-win.cjs",
    "dist:linux": "node scripts/build-linux.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.1.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "marked": "^18.1.0"
  }
}
